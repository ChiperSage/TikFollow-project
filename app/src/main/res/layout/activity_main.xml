<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp">

    <TextView android:id="@+id/status"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="16sp" android:paddingBottom="16dp"/>

    <Button android:id="@+id/btnEnable"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Aktifkan service (Accessibility)"/>

    <Button android:id="@+id/btnToggle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Start"/>

    <Button android:id="@+id/btnOpen"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Buka TikTok"/>

    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:text="Cara pakai: aktifkan service, tekan Start, buka TikTok ke halaman Suggested accounts / Find friends. Siklus: klik 1 Follow, scroll, jeda 15-18 detik."/>
</LinearLayout>
